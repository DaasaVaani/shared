{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/descriptor",
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$" },
    "descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "formatVersion", "sequence", "manifest"],
      "properties": {
        "format": { "const": "daasavaani-snapshot-feed" },
        "formatVersion": { "const": 1 },
        "sequence": { "$ref": "#/$defs/positive" },
        "manifest": { "$ref": "lyric-publication#/$defs/reference" }
      }
    },
    "policy": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "formatVersion", "logicalProjection", "transferPlanning"],
      "properties": {
        "format": { "const": "daasavaani-snapshot-policy" },
        "formatVersion": { "const": 1 },
        "logicalProjection": { "const": "canonical-prelaunch-v1" },
        "transferPlanning": { "$ref": "publication-policy#/$defs/transferPlanning" }
      }
    },
    "object": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "path", "encodedBytes", "decodedBytes", "requiredCapabilities"],
      "properties": {
        "role": { "enum": ["item", "policy"] },
        "path": { "type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json\\.gz$" },
        "encodedBytes": { "$ref": "#/$defs/positive" },
        "decodedBytes": { "$ref": "#/$defs/positive" },
        "requiredCapabilities": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "enum": ["lyric-preview-v1", "snapshot-policy-v1"] }
        }
      }
    },
    "catalogEntry": {
      "type": "object", "additionalProperties": false,
      "required": ["lyricId", "title", "tags", "item", "firstPublishedAt", "changedAt"],
      "properties": {
        "lyricId": { "$ref": "lyric-publication#/$defs/uuid" },
        "title": { "$ref": "lyric-publication#/$defs/title" },
        "tags": { "$ref": "lyric-publication#/$defs/tags" },
        "item": { "$ref": "#/$defs/hash" },
        "firstPublishedAt": { "$ref": "#/$defs/instant" },
        "changedAt": { "$ref": "#/$defs/instant" }
      }
    },
    "bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "encodedBytes", "changedAt", "members"],
      "properties": {
        "path": { "type": "string", "pattern": "^bundles/[0-9a-f]{64}\\.zip$" },
        "encodedBytes": { "$ref": "#/$defs/positive" },
        "changedAt": { "$ref": "#/$defs/instant" },
        "members": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } }
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "formatVersion", "stage", "logicalProjection", "requiredCapabilities", "policy", "objects", "catalog", "bundles"],
      "properties": {
        "format": { "const": "daasavaani-snapshot" },
        "formatVersion": { "const": 1 },
        "stage": { "const": "prelaunch" },
        "logicalProjection": { "const": "canonical-prelaunch-v1" },
        "requiredCapabilities": { "const": ["snapshot-envelope-v1", "lyric-preview-v1", "snapshot-policy-v1"] },
        "policy": { "$ref": "#/$defs/hash" },
        "objects": {
          "type": "object", "minProperties": 2, "propertyNames": { "$ref": "#/$defs/hash" },
          "additionalProperties": { "$ref": "#/$defs/object" }
        },
        "catalog": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/catalogEntry" } },
        "bundles": {
          "type": "object", "propertyNames": { "$ref": "#/$defs/hash" },
          "additionalProperties": { "$ref": "#/$defs/bundle" }
        }
      }
    }
  }
}
