{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/data",
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "point": { "type": "integer", "minimum": 0, "maximum": 1114111 },
    "script": { "type": "string", "pattern": "^[A-Z][a-z]{3}$" },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url", "bytes", "sha256"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://www\\.unicode\\.org/Public/16\\.0\\.0/ucd/(Scripts|ScriptExtensions|PropertyValueAliases)\\.txt$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "sourceHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["Scripts.txt", "ScriptExtensions.txt", "PropertyValueAliases.txt"],
      "properties": {
        "Scripts.txt": { "$ref": "#/$defs/hash" },
        "ScriptExtensions.txt": { "$ref": "#/$defs/hash" },
        "PropertyValueAliases.txt": { "$ref": "#/$defs/hash" }
      }
    },
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "profile", "unicodeVersion", "unicodeSourceSettings", "defaultScript", "extensionsDefault", "sources"],
      "properties": {
        "formatVersion": { "const": 1 },
        "profile": { "const": "unicode16-search-scripts-v1" },
        "unicodeVersion": { "const": "16.0.0" },
        "unicodeSourceSettings": { "const": "settings/unicode.yml" },
        "defaultScript": { "const": "Zzzz" },
        "extensionsDefault": { "const": "primary-script" },
        "sources": {
          "type": "object", "additionalProperties": false,
          "required": ["Scripts.txt", "ScriptExtensions.txt", "PropertyValueAliases.txt"],
          "properties": {
            "Scripts.txt": { "allOf": [{ "$ref": "#/$defs/source" }, { "type": "object", "properties": { "url": { "const": "https://www.unicode.org/Public/16.0.0/ucd/Scripts.txt" } } }] },
            "ScriptExtensions.txt": { "allOf": [{ "$ref": "#/$defs/source" }, { "type": "object", "properties": { "url": { "const": "https://www.unicode.org/Public/16.0.0/ucd/ScriptExtensions.txt" } } }] },
            "PropertyValueAliases.txt": { "allOf": [{ "$ref": "#/$defs/source" }, { "type": "object", "properties": { "url": { "const": "https://www.unicode.org/Public/16.0.0/ucd/PropertyValueAliases.txt" } } }] }
          }
        }
      }
    },
    "data": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "profile", "unicodeVersion", "defaultScript", "extensionsDefault", "sourceSha256", "licenseSha256", "scriptValues", "scriptRanges", "extensionRanges"],
      "properties": {
        "formatVersion": { "$ref": "#/$defs/settings/properties/formatVersion" },
        "profile": { "$ref": "#/$defs/settings/properties/profile" },
        "unicodeVersion": { "$ref": "#/$defs/settings/properties/unicodeVersion" },
        "defaultScript": { "$ref": "#/$defs/settings/properties/defaultScript" },
        "extensionsDefault": { "$ref": "#/$defs/settings/properties/extensionsDefault" },
        "sourceSha256": { "$ref": "#/$defs/sourceHashes" },
        "licenseSha256": { "$ref": "#/$defs/hash" },
        "scriptValues": {
          "type": "array", "minItems": 3,
          "items": { "type": "array", "minItems": 2, "maxItems": 2,
            "prefixItems": [{ "$ref": "#/$defs/script" }, { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }] }
        },
        "scriptRanges": {
          "type": "array", "minItems": 1,
          "items": { "type": "array", "minItems": 3, "maxItems": 3,
            "prefixItems": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/point" }, { "$ref": "#/$defs/script" }] }
        },
        "extensionRanges": {
          "type": "array", "minItems": 1,
          "items": { "type": "array", "minItems": 3, "maxItems": 3,
            "prefixItems": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/point" },
              { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/script" } }] }
        }
      }
    }
  }
}
