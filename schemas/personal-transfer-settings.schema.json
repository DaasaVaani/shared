{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formatVersion", "maxLists", "maxListNameCodePoints", "maxEntryTextCodePoints",
    "maxEntriesPerList", "maxTotalEntries", "maxFavorites", "maxBookmarks",
    "maxLearningLabels", "maxRecents", "maxListEncodedBytes", "maxListDecodedBytes",
    "maxBackupEncodedBytes", "maxBackupDecodedBytes", "maxSharedUrlAscii"
  ],
  "properties": {
    "formatVersion": { "const": 1 },
    "maxLists": { "$ref": "#/$defs/positiveInteger" },
    "maxListNameCodePoints": { "$ref": "#/$defs/positiveInteger" },
    "maxEntryTextCodePoints": { "$ref": "#/$defs/positiveInteger" },
    "maxEntriesPerList": { "$ref": "#/$defs/positiveInteger" },
    "maxTotalEntries": { "$ref": "#/$defs/positiveInteger" },
    "maxFavorites": { "$ref": "#/$defs/positiveInteger" },
    "maxBookmarks": { "$ref": "#/$defs/positiveInteger" },
    "maxLearningLabels": { "$ref": "#/$defs/positiveInteger" },
    "maxRecents": { "$ref": "#/$defs/positiveInteger" },
    "maxListEncodedBytes": { "$ref": "#/$defs/positiveInteger" },
    "maxListDecodedBytes": { "$ref": "#/$defs/positiveInteger" },
    "maxBackupEncodedBytes": { "$ref": "#/$defs/positiveInteger" },
    "maxBackupDecodedBytes": { "$ref": "#/$defs/positiveInteger" },
    "maxSharedUrlAscii": { "$ref": "#/$defs/positiveInteger" }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  }
}
