{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["formatVersion", "profile", "unicodeVersion", "algorithm", "license", "sources", "graphemeBreakRanges", "extendedPictographicRanges", "indicConjunctRanges"],
  "properties": {
    "formatVersion": { "$ref": "graphemes-settings#/properties/formatVersion" },
    "profile": { "$ref": "graphemes-settings#/properties/profile" },
    "unicodeVersion": { "$ref": "graphemes-settings#/properties/unicodeVersion" },
    "algorithm": { "$ref": "graphemes-settings#/properties/algorithm" },
    "license": { "$ref": "graphemes-settings#/properties/license" },
    "sources": { "$ref": "graphemes-settings#/properties/sources" },
    "graphemeBreakRanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/gcbRange" } },
    "extendedPictographicRanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/epRange" } },
    "indicConjunctRanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/incbRange" } }
  },
  "$defs": {
    "point": { "type": "integer", "minimum": 0, "maximum": 1114111 },
    "gcbRange": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/point" }, { "$ref": "#/$defs/point" },
        { "enum": ["CR", "LF", "Control", "Extend", "ZWJ", "Regional_Indicator", "Prepend", "SpacingMark", "L", "V", "T", "LV", "LVT"] }
      ]
    },
    "epRange": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "prefixItems": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/point" }]
    },
    "incbRange": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "prefixItems": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/point" }, { "enum": ["Consonant", "Extend", "Linker"] }]
    }
  }
}
