{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/descriptor",
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "text": { "type": "string", "pattern": "^[^\\r\\n]*$" },
    "title": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/title" } },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "path", "encodedBytes", "decodedBytes"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "path": { "type": "string", "pattern": "^objects/[0-9a-f]{64}\\.json\\.gz$" },
        "encodedBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "decodedBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "descriptor": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "formatVersion", "manifest"],
      "properties": {
        "format": { "const": "daasavaani-lyrics" },
        "formatVersion": { "const": 1 },
        "manifest": { "$ref": "#/$defs/reference" }
      }
    },
    "manifest": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "formatVersion", "stage", "requiredCapabilities", "catalog"],
      "properties": {
        "format": { "const": "daasavaani-lyric-catalog" },
        "formatVersion": { "const": 1 },
        "stage": { "const": "prelaunch" },
        "requiredCapabilities": { "type": "array", "minItems": 1, "maxItems": 1, "items": { "const": "lyric-preview-v1" } },
        "catalog": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["lyricId", "title", "tags", "item"],
            "properties": {
              "lyricId": { "$ref": "#/$defs/uuid" },
              "title": { "$ref": "#/$defs/title" },
              "tags": { "$ref": "#/$defs/tags" },
              "item": { "$ref": "#/$defs/reference" }
            }
          }
        }
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "formatVersion", "lyricId", "canonicalScript", "title", "tags", "lines"],
      "properties": {
        "format": { "const": "daasavaani-lyric" },
        "formatVersion": { "const": 1 },
        "lyricId": { "$ref": "#/$defs/uuid" },
        "canonicalScript": { "const": "kn" },
        "title": { "$ref": "#/$defs/title" },
        "tags": { "$ref": "#/$defs/tags" },
        "lines": {
          "type": "array", "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "lineId", "text"],
                "properties": { "kind": { "const": "line" }, "lineId": { "$ref": "#/$defs/uuid" }, "text": { "$ref": "#/$defs/title" } }
              },
              {
                "type": "object", "additionalProperties": false, "required": ["kind", "text"],
                "properties": { "kind": { "const": "layout" }, "text": { "type": "string", "pattern": "^[ \\t]*$" } }
              }
            ]
          }
        }
      }
    }
  }
}
