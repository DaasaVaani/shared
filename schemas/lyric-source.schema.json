{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["sourceFormat", "lyricId", "public", "provenance", "review"],
  "properties": {
    "sourceFormat": { "const": 2 },
    "lyricId": { "$ref": "#/$defs/uuid" },
    "public": {
      "type": "object", "additionalProperties": false, "required": ["title", "tags"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "pattern": "^[^\\r\\n]+$" },
        "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "classification": {
          "type": "object", "additionalProperties": false,
          "required": ["composerIds", "ankitaIds", "deityIds", "formIds", "categoryIds", "contextIds"],
          "properties": {
            "composerIds": { "$ref": "#/$defs/registryIds" },
            "ankitaIds": { "$ref": "#/$defs/registryIds" },
            "deityIds": { "$ref": "#/$defs/registryIds" },
            "formIds": { "$ref": "#/$defs/registryIds" },
            "categoryIds": { "$ref": "#/$defs/registryIds" },
            "contextIds": { "$ref": "#/$defs/registryIds" }
          }
        },
        "contextDescription": { "type": "string" },
        "verses": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "endsAt"],
            "properties": { "id": { "$ref": "#/$defs/uuid" }, "endsAt": { "$ref": "#/$defs/uuid" } }
          }
        },
        "youtube": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["videoId", "url"],
            "properties": {
              "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
              "url": { "$ref": "#/$defs/optionalHttpsUrl" }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["asset", "alt"],
            "properties": {
              "asset": { "$ref": "#/$defs/asset" },
              "alt": { "type": "string" }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sourceFile", "sha256", "encoding"],
      "properties": {
        "kind": { "const": "owner-supplied" },
        "sourceFile": { "type": "string", "pattern": "^[^\\\\/\\u0000-\\u001f]+\\.txt$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "encoding": { "enum": ["utf-8", "utf-16le", "utf-16be"] },
        "sourceUrls": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/httpsUrl" } },
        "description": { "type": "string" },
        "rights": {
          "type": "object", "additionalProperties": false, "required": ["license", "attribution", "evidenceUrls"],
          "properties": {
            "license": { "type": "string" }, "attribution": { "type": "string" },
            "evidenceUrls": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/httpsUrl" } }
          }
        },
        "videos": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["videoId", "originalTitle", "channelId", "channelName", "uploadedOn", "description"],
            "properties": {
              "videoId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
              "originalTitle": { "type": "string" }, "channelId": { "type": "string" },
              "channelName": { "type": "string" },
              "uploadedOn": { "type": "string", "pattern": "^(?:|[0-9]{4}-[0-9]{2}-[0-9]{2})$" },
              "description": { "type": "string" }
            }
          }
        },
        "images": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["asset", "sourceUrl", "creator", "license", "attribution"],
            "properties": {
              "asset": { "$ref": "#/$defs/asset" },
              "sourceUrl": { "$ref": "#/$defs/optionalHttpsUrl" },
              "creator": { "type": "string" }, "license": { "type": "string" }, "attribution": { "type": "string" }
            }
          }
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false, "required": ["holdReasons"],
      "properties": {
        "holdReasons": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "sourceLatin": {
          "type": "object", "additionalProperties": false, "required": ["readable", "searchable", "alignment"],
          "properties": {
            "readable": { "type": ["boolean", "null"] },
            "searchable": { "type": ["boolean", "null"] },
            "alignment": {
              "type": "array",
              "items": {
                "type": "object", "additionalProperties": false, "required": ["lineId", "ranges"],
                "properties": {
                  "lineId": { "$ref": "#/$defs/uuid" },
                  "ranges": {
                    "type": "array", "minItems": 1,
                    "items": {
                      "type": "array", "minItems": 2, "maxItems": 2,
                      "items": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "registryIds": {
      "type": "array", "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" }
    },
    "httpsUrl": { "type": "string", "pattern": "^https://[^\\s]+$" },
    "optionalHttpsUrl": { "type": "string", "pattern": "^(?:|https://[^\\s]+)$" },
    "asset": { "type": "string", "pattern": "^assets/(?:[A-Za-z0-9_-][A-Za-z0-9_.-]*/)*[A-Za-z0-9_-][A-Za-z0-9_.-]*$" }
  }
}
