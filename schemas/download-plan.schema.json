{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daasavaani.github.io/contracts/download-plan.schema.json",
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nonNegative": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positive": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "hashes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/hash" } },
    "object": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "encodedBytes"],
      "properties": { "sha256": { "$ref": "#/$defs/hash" }, "encodedBytes": { "$ref": "#/$defs/positive" } }
    },
    "bundle": {
      "type": "object", "additionalProperties": false, "required": ["sha256", "encodedBytes", "members"],
      "properties": {
        "sha256": { "$ref": "#/$defs/hash" }, "encodedBytes": { "$ref": "#/$defs/positive" },
        "members": { "type": "array", "allOf": [{ "$ref": "#/$defs/hashes" }], "minItems": 1 }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "objects", "required", "verified", "bundles"],
      "properties": {
        "formatVersion": { "const": 1 },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/object" } },
        "required": { "$ref": "#/$defs/hashes" }, "verified": { "$ref": "#/$defs/hashes" },
        "bundles": { "type": "array", "items": { "$ref": "#/$defs/bundle" } }
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "sha256", "encodedBytes", "covers"],
      "properties": {
        "kind": { "enum": ["bundle", "object"] },
        "sha256": { "$ref": "#/$defs/hash" }, "encodedBytes": { "$ref": "#/$defs/positive" },
        "covers": { "type": "array", "allOf": [{ "$ref": "#/$defs/hashes" }], "minItems": 1 }
      },
      "if": { "properties": { "kind": { "const": "object" } } },
      "then": { "properties": { "covers": { "type": "array", "maxItems": 1 } } }
    },
    "plan": {
      "type": "object", "additionalProperties": false,
      "required": [
        "formatVersion", "requests", "requestCount", "missingEncodedBytes", "transferEncodedBytes",
        "extraEncodedBytes", "extraBudgetBytes", "baselineCostBytes", "costBytes", "savedCostBytes"
      ],
      "properties": {
        "formatVersion": { "const": 1 },
        "requests": { "type": "array", "items": { "$ref": "#/$defs/request" } },
        "requestCount": { "$ref": "#/$defs/nonNegative" },
        "missingEncodedBytes": { "$ref": "#/$defs/nonNegative" },
        "transferEncodedBytes": { "$ref": "#/$defs/nonNegative" },
        "extraEncodedBytes": { "$ref": "#/$defs/nonNegative" },
        "extraBudgetBytes": { "$ref": "#/$defs/nonNegative" },
        "baselineCostBytes": { "$ref": "#/$defs/nonNegative" },
        "costBytes": { "$ref": "#/$defs/nonNegative" },
        "savedCostBytes": { "$ref": "#/$defs/nonNegative" }
      }
    }
  }
}
