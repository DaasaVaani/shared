{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daasavaani.org/schemas/content-state.schema.json",
  "$ref": "#/$defs/ContentDataset",
  "$defs": {
    "SafeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "PositiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "Sha256": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" },
    "Epoch": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])" },
    "ContentReference": {
      "type": "object", "additionalProperties": false,
      "required": ["sequence", "manifestSha256"],
      "properties": {
        "sequence": { "$ref": "#/$defs/PositiveInteger" },
        "manifestSha256": { "$ref": "#/$defs/Sha256" }
      }
    },
    "ContentObjectReceipt": {
      "type": "object", "additionalProperties": false,
      "required": ["sha256", "encodedBytes"],
      "properties": {
        "sha256": { "$ref": "#/$defs/Sha256" },
        "encodedBytes": { "$ref": "#/$defs/PositiveInteger" }
      }
    },
    "ContentPlan": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "required"],
      "properties": {
        "reference": { "$ref": "#/$defs/ContentReference" },
        "required": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/ContentObjectReceipt" }
        }
      }
    },
    "ContentTarget": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "phase"],
      "properties": {
        "reference": { "$ref": "#/$defs/ContentReference" },
        "phase": { "enum": ["downloading", "paused"] }
      }
    },
    "ContentState": {
      "type": "object", "additionalProperties": false,
      "required": ["formatVersion", "epoch", "revision", "active", "target", "retired"],
      "properties": {
        "formatVersion": { "const": 1 },
        "epoch": { "$ref": "#/$defs/Epoch" },
        "revision": { "$ref": "#/$defs/SafeInteger" },
        "active": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ContentReference" }] },
        "target": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/ContentTarget" }] },
        "retired": { "type": "array", "items": { "$ref": "#/$defs/ContentReference" } }
      }
    },
    "ContentDataset": {
      "type": "object", "additionalProperties": false,
      "required": ["control", "snapshots", "objects"],
      "properties": {
        "control": { "$ref": "#/$defs/ContentState" },
        "snapshots": { "type": "array", "items": { "$ref": "#/$defs/ContentPlan" } },
        "objects": { "type": "array", "items": { "$ref": "#/$defs/ContentObjectReceipt" } }
      }
    },
    "ContentLimits": {
      "type": "object", "additionalProperties": false,
      "required": ["maxLogicalBytes", "maxObjects", "maxSnapshots", "maxObjectBytes"],
      "properties": {
        "maxLogicalBytes": { "$ref": "#/$defs/PositiveInteger" },
        "maxObjects": { "$ref": "#/$defs/PositiveInteger" },
        "maxSnapshots": { "$ref": "#/$defs/PositiveInteger" },
        "maxObjectBytes": { "$ref": "#/$defs/PositiveInteger" }
      }
    },
    "ExpectedContent": {
      "type": "object", "additionalProperties": false,
      "required": ["epoch", "revision"],
      "properties": {
        "epoch": { "$ref": "#/$defs/Epoch" },
        "revision": { "$ref": "#/$defs/SafeInteger" }
      }
    }
  }
}
