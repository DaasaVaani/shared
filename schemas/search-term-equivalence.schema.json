{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/input",
  "$defs": {
    "policy": {
      "type": "object", "additionalProperties": false, "required": ["maxTerms"],
      "properties": { "maxTerms": { "$ref": "search-policy#/properties/maxTerms" } }
    },
    "integer": { "$ref": "search-tables#/$defs/integer" },
    "term": {
      "type": "object", "additionalProperties": false, "required": ["profiles"],
      "properties": {
        "profiles": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["profileId", "tokens"],
            "properties": {
              "profileId": { "$ref": "search-tables#/$defs/profileId" },
              "tokens": {
                "type": "array",
                "items": {
                  "type": "object", "additionalProperties": false, "required": ["text", "edits"],
                  "properties": {
                    "text": { "$ref": "search-tables#/$defs/text" },
                    "edits": { "type": "integer", "minimum": 0, "maximum": 2 }
                  }
                }
              }
            }
          }
        }
      }
    },
    "input": {
      "type": "object", "additionalProperties": false, "required": ["policySha256", "profiles", "terms"],
      "properties": {
        "policySha256": { "$ref": "search-tables#/$defs/hash" },
        "profiles": { "$ref": "search-tables#/$defs/profiles" },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/term" } }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "formatVersion", "policySha256", "profiles", "inputToTerm", "terms"],
      "properties": {
        "format": { "const": "daasavaani-search-term-equivalence" },
        "formatVersion": { "const": 1 },
        "policySha256": { "$ref": "search-tables#/$defs/hash" },
        "profiles": { "$ref": "search-tables#/$defs/profiles" },
        "inputToTerm": { "type": "array", "items": { "$ref": "#/$defs/integer" } },
        "terms": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["representative", "inputs"],
            "properties": {
              "representative": { "$ref": "#/$defs/integer" },
              "inputs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/integer" } }
            }
          }
        }
      }
    }
  }
}
