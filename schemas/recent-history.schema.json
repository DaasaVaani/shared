{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daasavaani.github.io/contracts/recent-history-v1.schema.json",
  "$comment": "Generated by tools/generate-personal-contracts.mjs from settings/personal-transfer.yml. Do not edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "enabled",
    "entries"
  ],
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "entries": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "lyricId"
            ],
            "properties": {
              "kind": {
                "const": "lyric"
              },
              "lyricId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "videoId"
            ],
            "properties": {
              "kind": {
                "const": "legacyVideo"
              },
              "videoId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              }
            }
          }
        ]
      }
    }
  }
}
