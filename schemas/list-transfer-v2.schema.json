{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daasavaani.github.io/contracts/list-transfer-v2.schema.json",
  "$comment": "Generated by tools/generate-personal-contracts.mjs from settings/personal-transfer.yml. Do not edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "formatVersion",
    "name",
    "entries"
  ],
  "properties": {
    "format": {
      "const": "daasavaani-list"
    },
    "formatVersion": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff]*$"
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "lyricId"
            ],
            "properties": {
              "kind": {
                "const": "lyric"
              },
              "lyricId": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "fallback": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff]*$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "videoId"
            ],
            "properties": {
              "kind": {
                "const": "legacyVideo"
              },
              "videoId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,128}$"
              },
              "fallback": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff]*$"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "text"
            ],
            "properties": {
              "kind": {
                "const": "placeholder"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ud800-\\udfff]*$"
              }
            }
          }
        ]
      }
    }
  }
}
