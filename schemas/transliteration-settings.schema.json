{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daasavaani.org/schemas/transliteration-settings.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "rulesId", "revision", "status", "sourceScript", "unicodeProfile", "profiles", "alphabet", "unsupportedTargets"],
  "properties": {
    "formatVersion": { "const": 1 },
    "rulesId": { "const": "kannada-multiscript-provisional-v1" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "status": { "const": "provisional-owner-review" },
    "sourceScript": { "const": "kn" },
    "unicodeProfile": { "const": "unicode16-default-full-nfc-v1" },
    "profiles": {
      "type": "array", "minItems": 14, "maxItems": 14,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "kind", "label", "vowels", "consonants", "marks"],
        "properties": {
          "id": { "enum": ["iso15919", "iast-kn", "baraha-kn", "itrans-kn", "harvard-kyoto-kn", "deva", "telu", "taml", "mlym", "gujr", "beng", "asam", "guru", "orya"] },
          "kind": { "enum": ["latin", "native"] },
          "label": { "type": "string", "minLength": 1 },
          "vowels": { "$ref": "#/$defs/targetVowels" },
          "consonants": { "$ref": "#/$defs/targetConsonants" },
          "marks": { "$ref": "#/$defs/targetMarks" },
          "vowelSigns": { "$ref": "#/$defs/targetVowels" },
          "virama": { "$ref": "#/$defs/token" },
          "digits": { "type": "string", "minLength": 10, "maxLength": 10 },
          "consonantSuffixes": { "type": "array", "minItems": 34, "maxItems": 34, "items": { "enum": ["", "²", "³", "⁴"] } },
          "approximations": {
            "type": "array",
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["category", "index", "reason"],
              "properties": {
                "category": { "enum": ["vowels", "vowelSigns", "consonants", "marks"] },
                "index": { "type": "integer", "minimum": 0, "maximum": 33 },
                "reason": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "kind": { "const": "native" } } },
            "then": {
              "properties": { "vowelSigns": {}, "virama": {}, "digits": {}, "approximations": {} },
              "required": ["vowelSigns", "virama", "digits", "approximations"]
            },
            "else": {
              "properties": {
                "vowels": { "$ref": "#/$defs/vowels" },
                "consonants": { "$ref": "#/$defs/consonants" },
                "marks": { "$ref": "#/$defs/marks" }
              },
              "not": {
                "properties": { "vowelSigns": {}, "virama": {}, "digits": {}, "approximations": {} },
                "anyOf": [{ "required": ["vowelSigns"] }, { "required": ["virama"] }, { "required": ["digits"] }, { "required": ["approximations"] }]
              }
            }
          },
          {
            "if": { "properties": { "id": { "const": "taml" } } },
            "then": { "properties": { "consonantSuffixes": {} }, "required": ["consonantSuffixes"] },
            "else": { "not": { "properties": { "consonantSuffixes": {} }, "required": ["consonantSuffixes"] } }
          }
        ]
      }
    },
    "alphabet": {
      "type": "object", "additionalProperties": false,
      "required": ["vowels", "vowelSigns", "consonants", "marks", "virama", "digits", "asciiDigits", "passthrough"],
      "properties": {
        "vowels": { "$ref": "#/$defs/vowels" },
        "vowelSigns": {
          "type": "array", "minItems": 16, "maxItems": 16,
          "items": { "type": ["string", "null"], "minLength": 1, "maxLength": 1 }
        },
        "consonants": { "$ref": "#/$defs/consonants" },
        "marks": { "$ref": "#/$defs/marks" },
        "virama": { "type": "string", "minLength": 1, "maxLength": 1 },
        "digits": { "type": "string", "minLength": 10, "maxLength": 10 },
        "asciiDigits": { "const": "0123456789" },
        "passthrough": { "type": "string", "minLength": 1 }
      }
    },
    "unsupportedTargets": { "const": [] }
  },
  "$defs": {
    "token": { "type": "string", "minLength": 1 },
    "vowels": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/token" } },
    "consonants": { "type": "array", "minItems": 34, "maxItems": 34, "items": { "$ref": "#/$defs/token" } },
    "marks": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/token" } },
    "targetToken": { "type": ["string", "null"], "minLength": 1 },
    "targetVowels": { "type": "array", "minItems": 16, "maxItems": 16, "items": { "$ref": "#/$defs/targetToken" } },
    "targetConsonants": { "type": "array", "minItems": 34, "maxItems": 34, "items": { "$ref": "#/$defs/targetToken" } },
    "targetMarks": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/targetToken" } }
  }
}
