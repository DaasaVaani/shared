# Unicode provenance and generated-resource hashes are over these exact LF bytes.
resources/unicode16/* text eol=lf
generated/unicode/* text eol=lf
fixtures/unicode-name-matching.json text eol=lf
# Transliteration provenance hashes these exact settings and generated bytes.
settings/transliteration.yml text eol=lf
generated/transliteration/* text eol=lf
# Grapheme data and generated manifests hash the unmodified upstream LF bytes.
resources/graphemes16/* text eol=lf
resources/graphemes16/emoji-data.txt whitespace=-blank-at-eol
generated/graphemes/* text eol=lf
settings/graphemes.yml text eol=lf
# Preserve exact licensed reference snapshots, including upstream whitespace.
resources/latin-reference-audit/* text eol=lf
resources/latin-reference-audit/baraha.toml whitespace=-blank-at-eol
resources/latin-reference-audit/iso.toml whitespace=-blank-at-eol
resources/latin-reference-audit/ITRANS-DEFAULT.tsv -text whitespace=-blank-at-eol
resources/latin-reference-audit/kannada.toml whitespace=-blank-at-eof
settings/search-characters.yml text eol=lf
generated/search-characters/* text eol=lf
settings/search-lexing.yml text eol=lf
